{
  "type": "module",
  "scripts": {
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "rsbuild build",
    "check": "run-s type-check lint test:unit",
    "dev": "rsbuild build --watch --env-mode=development",
    "lint:oxlint": "oxlint . -D correctness --ignore-path ../.gitignore",
    "lint:eslint": "eslint .",
    "lint": "run-s lint:*",
    "prettier": "prettier --write src/",
    "test:unit": "vitest --passWithNoTests",
    "type-check": "vue-tsc --build"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@5": "5.0.8",
      "immutable": "5.1.9",
      "js-yaml": "4.3.0",
      "postcss": "8.5.24",
      "shell-quote": "1.9.0"
    }
  },
  "prettier": {
    "printWidth": 100,
    "semi": false,
    "singleQuote": true,
    "tabWidth": 2
  },
  "dependencies": {
    "@halo-dev/api-client": "^2.25.1",
    "@halo-dev/components": "^2.25.1",
    "@halo-dev/ui-shared": "^2.25.1",
    "axios": "^1.13.5",
    "vue": "^3.5.28"
  },
  "devDependencies": {
    "@halo-dev/ui-plugin-bundler-kit": "^2.25.1",
    "@iconify-json/ri": "^1.2.10",
    "@rsbuild/core": "^2.0.0",
    "@rsbuild/plugin-sass": "^2.0.0",
    "@tsconfig/node20": "^20.1.6",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.13.1",
    "@vitest/eslint-plugin": "^1.2.7",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.5.1",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^10.8.0",
    "eslint-plugin-oxlint": "^0.16.12",
    "eslint-plugin-vue": "^10.10.0",
    "jiti": "^2.7.0",
    "jsdom": "^26.1.0",
    "npm-run-all2": "^8.0.4",
    "oxlint": "^0.16.12",
    "prettier": "^3.8.3",
    "sass": "^1.89.2",
    "typescript": "~5.8.3",
    "unplugin-icons": "^23.0.1",
    "vitest": "^4.1.0",
    "vue-tsc": "^3.3.3"
  },
  "packageManager": "pnpm@10.12.4"
}
