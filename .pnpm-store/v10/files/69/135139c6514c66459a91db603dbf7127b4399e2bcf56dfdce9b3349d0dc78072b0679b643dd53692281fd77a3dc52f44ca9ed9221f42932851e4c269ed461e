 *
 * @typeParam T - The type of entity this operation applies to (e.g., ListedPost, Plugin, Theme).
 *
 * @example
 * ```typescript
 * const exportOperation: OperationItem<ListedPost> = {
 *   priority: 20,
 *   component: markRaw(VButton),
